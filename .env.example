# Database (SQLite for local zero-config development, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example (use with prisma/schema.postgresql.prisma):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/onetab_distribution?schema=public"

# Authentication & Security
AUTH_SECRET="replace-with-at-least-32-character-random-secret"
APP_URL="http://localhost:3000"

# Storage (local or s3)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Media Requirements
ARTWORK_MIN_SIZE="1400"
ARTWORK_RECOMMENDED_SIZE="3000"
MAX_AUDIO_MB="150"
MAX_VIDEO_MB="500"
MAX_IMAGE_MB="25"

# Email / SMTP (optional; logs locally to EmailLog when unconfigured)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="support@onetabmedia.in"

# Third-Party Distribution & DSP Integrations (optional; runs in honest pending/internal review mode when unset)
VYDIA_API_KEY=""
VYDIA_API_BASE_URL=""
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
APPLE_MUSIC_KEY_ID=""
APPLE_MUSIC_TEAM_ID=""
YOUTUBE_API_KEY=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AI Customer Support & Two-Way Email Handover (optional; can also be configured & encrypted via /admin/chatbot)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
POSTMARK_SERVER_TOKEN=""
SENDGRID_API_KEY=""
RESEND_API_KEY=""
EMAIL_INBOUND_WEBHOOK_SECRET=""
